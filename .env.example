BOT_TOKEN=123456:PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
ADMIN_ID=123456789
# Опционально: канал для автопостинга подписок
CHANNEL_ID=@your_channel
# Режим проверки конфигов: none | syntax | tcp
CHECK_MODE=syntax
# Интервал автообновления в минутах
UPDATE_INTERVAL=30
# Хостинг подписок (если деплоишь HTTP сервер)
PUBLIC_URL=https://yourdomain.com
PORT=8080

# === GitHub RAW публикация (для одной большой ссылки) ===
GITHUB_TOKEN=ghp_xxx_your_token_here
GITHUB_REPO=xznexil3/vless-parser-bot
GITHUB_BRANCH=main
# Путь внутри репо (пусто = корень, или "subs")
GITHUB_SUB_PATH=
